# Kopieren nach deploy/.env und anpassen.

# Öffentlicher Name von xlrx (DNS zeigt auf die Heimat-IP, Router leitet an CADDY_IP weiter).
XLRX_HOST=drive.example.de
# Optional: weitere erlaubte Adressen, z.B. ein LAN-Name mit eigenem Zertifikat (https://drive-lan.example.de).
XLRX_EXTRA_ORIGINS=
# Domain der Passkeys. EINMAL festlegen, eine spätere Änderung macht alle Passkeys ungültig.
# Die Hauptdomain (example.de) erlaubt Passkeys auch für weitere Adressen aus XLRX_EXTRA_ORIGINS.
XLRX_RP_ID=example.de
ACME_EMAIL=admin@example.de

# DSM-Benutzer `xlrx` (Systemsteuerung → Benutzer; IDs per `id xlrx` über SSH).
PUID=1027
PGID=100

# macvlan für Caddy: freie IP außerhalb des DHCP-Bereichs des Routers.
# LAN_PARENT: `ovs_eth0`, wenn Open vSwitch aktiv ist (z.B. wegen Virtual Machine Manager), sonst `eth0`.
LAN_PARENT=ovs_eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
CADDY_IP=192.168.1.20

# Ablage
XLRX_DB_DIR=/volume1/xlrx-db
CADDY_DIR=/volume1/docker/xlrx/caddy

# Postgres-Speicher (16–20 GB RAM im NAS)
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE=8GB

# Passwort-Hashing: auf dem NAS kalibrieren (spikes/ds918/run.sh), Ziel ~250 ms je Prüfung.
XLRX_ARGON2_M_KIB=19456
XLRX_ARGON2_T=2
