# Copy to deploy/.env and adjust.

# Public hostname of xlrx (DNS points to your home IP, the router forwards to CADDY_IP).
XLRX_HOST=drive.example.de
# Optional: additional allowed origins, e.g. a LAN name with its own certificate (https://drive-lan.example.de).
XLRX_EXTRA_ORIGINS=
# Passkey domain. Set it ONCE; changing it later invalidates all passkeys.
# The parent domain (example.de) also allows passkeys for the additional origins in XLRX_EXTRA_ORIGINS.
XLRX_RP_ID=example.de
ACME_EMAIL=admin@example.de

# DSM user `xlrx` (Control Panel → User & Group; get the IDs via `id xlrx` over SSH).
PUID=1027
PGID=100

# macvlan for Caddy: a free IP outside the router's DHCP range.
# LAN_PARENT: `ovs_eth0` if Open vSwitch is active (e.g. because of Virtual Machine Manager), otherwise `eth0`.
LAN_PARENT=ovs_eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
CADDY_IP=192.168.1.20

# Storage locations
XLRX_DB_DIR=/volume1/xlrx-db
CADDY_DIR=/volume1/docker/xlrx/caddy

# Postgres memory (16–20 GB RAM in the NAS)
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE=8GB

# Password hashing: calibrate on the NAS (spikes/ds918/run.sh), target ~250 ms per check.
XLRX_ARGON2_M_KIB=19456
XLRX_ARGON2_T=2
