# Copy to deploy/.env and adjust.

# Public hostname of xlrx (DNS points to your home IP, the router forwards to CADDY_IP).
XLRX_HOST=drive.example.de
# Optional: additional allowed origins, e.g. a LAN name with its own certificate (https://drive-lan.example.de).
XLRX_EXTRA_ORIGINS=
# Passkey domain. Set it ONCE; changing it later invalidates all passkeys.
# The parent domain (example.de) also allows passkeys for the additional origins in XLRX_EXTRA_ORIGINS.
XLRX_RP_ID=example.de
ACME_EMAIL=admin@example.de

# DSM user `xlrx` (Control Panel → User & Group; get the IDs via `id xlrx` over SSH).
PUID=1027
PGID=100

# macvlan for Caddy: a free IP outside the router's DHCP range.
# LAN_PARENT: `ovs_eth0` if Open vSwitch is active (e.g. because of Virtual Machine Manager), otherwise `eth0`.
LAN_PARENT=ovs_eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
CADDY_IP=192.168.1.20

# Storage locations
XLRX_DB_DIR=/volume1/xlrx-db
CADDY_DIR=/volume1/docker/xlrx/caddy

# Postgres memory (16–20 GB RAM in the NAS)
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE=8GB

# Password hashing: calibrate on the NAS (spikes/ds918/run.sh), target ~250 ms per check.
XLRX_ARGON2_M_KIB=19456
XLRX_ARGON2_T=2

# Data class of folders without a setting of their own: local ("Nur lokal", never processed outside
# the home network) or cloud ("Cloud erlaubt"). Keep local and allow single folders in the web app.
XLRX_DEFAULT_DATA_CLASS=local

# Largest file someone may send through a public link ("Nur hochladen" or "Bearbeiten"), in MB.
XLRX_LINK_UPLOAD_MAX_MB=10240

# Time zone of the household (start page suggestions such as "usually opened on Mondays").
XLRX_TIMEZONE=Europe/Berlin

# Outside cache in S3 (deploy/synology.md, section "Außen-Beschleuniger"). Off while empty.
# Keys go into secrets/s3_access_key and secrets/s3_secret_key.
XLRX_S3_BUCKET=
XLRX_S3_ENDPOINT=https://fsn1.your-objectstorage.com
XLRX_S3_REGION=fsn1
# Size of the cache and upload limit (the home line stays usable).
XLRX_S3_BUDGET_GB=200
XLRX_S3_UPLOAD_MBIT=20
# Your home's public IPv6 prefix, if fixed (devices at home use it): e.g. 2001:db8:1234::/56
XLRX_LAN_NETS=

# AI search (deploy/synology.md, section "KI-Suche").
# "Nur lokal": embed-local on the NAS (models in XLRX_MODELS_DIR, fetched once, ~1.6 GB).
XLRX_MODELS_DIR=/volume1/docker/xlrx/models
# Cores embed-local may use (of four).
XLRX_EMBED_THREADS=2
# Search pictures in "Nur lokal" by what they show (CLIP, ~0.9 GB of memory). 0 = off; then also
# XLRX_LOCAL_CLIP_MODEL=off.
XLRX_EMBED_CLIP=1
XLRX_LOCAL_CLIP_MODEL=clip-ViT-B-32-multilingual-v1
# "Cloud erlaubt": a provider in the EU with the OpenAI API, e.g. Scaleway (Paris). Off while
# empty. Key in secrets/ai_key. It only runs once an administrator starts it, and pauses when the
# monthly budget (euros) is spent.
XLRX_AI_URL=
XLRX_AI_EMBED_MODEL=qwen3-embedding-8b
XLRX_AI_VISION_MODEL=gemma-4-26b-a4b-it
XLRX_AI_BUDGET_EUR=20
