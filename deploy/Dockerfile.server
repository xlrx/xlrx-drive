# syntax=docker/dockerfile:1.7
# xlrx-server with the web app. Built for x86-64-v2 (DS918+/J3455: no AVX), see PLAN 3.1.
#   docker build -f deploy/Dockerfile.server -t xlrx-server .

FROM node:22-bookworm-slim AS web
WORKDIR /web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
# Scripts run after the sources are copied (`nuxi prepare` needs nuxt.config.ts).
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY web/ ./
RUN pnpm run build

FROM rust:1.97-bookworm AS build
WORKDIR /src
ENV RUSTFLAGS="-C target-cpu=x86-64-v2" \
    CARGO_TERM_COLOR=never
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p xlrx-server -p xlrx-chunk --bins --examples \
 && mkdir -p /out \
 && cp target/release/xlrx-server target/release/examples/hashdir /out/

FROM debian:bookworm-slim
# poppler-utils: text of PDFs, page images for OCR; tesseract: OCR of scans (German, English).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
      poppler-utils tesseract-ocr tesseract-ocr-deu tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/xlrx-server /out/hashdir /usr/local/bin/
COPY --from=web /web/.output/public /srv/web
ENV XLRX_WEB_DIR=/srv/web \
    XLRX_BIND=0.0.0.0:8080 \
    RUST_LOG=info,sqlx=warn
# Never runs as root; compose sets the IDs of the DSM user `xlrx` (PUID/PGID).
USER 65534:65534
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["xlrx-server"]
