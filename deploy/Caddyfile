# Caddy in front of xlrx: Let's Encrypt, HTTP/3 (QUIC) with fallback to HTTP/2/1.1.
# Add existing rules from the DSM reverse proxy below (PLAN 15.3).
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$XLRX_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy server:8080 {
		# Pass Server-Sent Events (sync notifications) through unbuffered.
		flush_interval -1
	}
}

# Example of a migrated DSM rule:
# fotos.example.de {
# 	reverse_proxy 192.168.1.10:5080
# }
